# LDAP Manager Production Environment Variables

# Context path for reverse proxy deployment (optional)
# Example: /ldap-manager for https://example.com/ldap-manager
CONTEXT_PATH=

# CORS allowed origins (comma-separated)
# Example: https://ldap.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Logging configuration
LOG_LEVEL=INFO
JSON_LOGS=true

# Server port
PORT=8000

# --- Cluster credentials -----------------------------------------------------
# One variable per cluster, when that cluster's credential source is 'env'.
# The name is: LDAP_MANAGER_CLUSTER_<CLUSTER_NAME>_PASSWORD
# Cluster name upper-cased, every run of non-alphanumeric characters -> "_"
#
#   vibhuvioio        -> LDAP_MANAGER_CLUSTER_VIBHUVIOIO_PASSWORD
#   oiocloud          -> LDAP_MANAGER_CLUSTER_OIOCLOUD_PASSWORD
#   my-cluster-2      -> LDAP_MANAGER_CLUSTER_MY_CLUSTER_2_PASSWORD
#   Production LDAP   -> LDAP_MANAGER_CLUSTER_PRODUCTION_LDAP_PASSWORD
#
# A cluster with a 'config:' block (Schema and ACI editors) also needs:
#   LDAP_MANAGER_CONFIG_<CLUSTER_NAME>_PASSWORD
#
# Adding a cluster means adding one line here - the compose files never change.

# LDAP_MANAGER_CLUSTER_VIBHUVIOIO_PASSWORD=
# LDAP_MANAGER_CLUSTER_OIOCLOUD_PASSWORD=
# LDAP_MANAGER_CONFIG_VIBHUVIOIO_PASSWORD=

# IMPORTANT: Never commit actual secrets to version control
# Add .env to .gitignore
